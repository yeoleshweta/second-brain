# ── Railway / Cloud environment variables ────────────────────────────────────
# Copy these into Railway's "Variables" UI (or any cloud host's env config).
# These sit alongside the base .env.example values.

# ── LLM ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL_MAIN=gpt-4o
OPENAI_MODEL_CHEAP=gpt-4o-mini

# ── App ───────────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
ENVIRONMENT=production
LOG_LEVEL=INFO

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_API_TOKEN=change-me-generate-a-real-token

# ── Obsidian (cloud mode — writes markdown files directly to /vault volume) ───
# OBSIDIAN_API_KEY must be EMPTY in cloud — triggers filesystem mode
OBSIDIAN_API_KEY=
# /vault is the Railway persistent volume (see railway.toml volumes section)
OBSIDIAN_VAULT_PATH=/vault

# ── Storage ───────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:////data/secondbrain.db
DATA_DIR=/data

# ── CORS — your Railway public URL + Capacitor origins ────────────────────────
# Add your Railway URL here so it's trusted. Capacitor origins are always allowed.
# Example: FRONTEND_ORIGIN=https://second-brain-production.up.railway.app
FRONTEND_ORIGIN=https://your-app.up.railway.app

# ── Finance — Plaid ───────────────────────────────────────────────────────────
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PLAID_TOKEN_ENCRYPTION_KEY=

# ── Calendar — Google ─────────────────────────────────────────────────────────
# Upload your google_token.json to Railway as a secret file, or store its content
# in an env var and write it to disk on startup.
GOOGLE_TOKEN_PATH=/data/google_token.json

# ── Knowledge agent ───────────────────────────────────────────────────────────
TAVILY_API_KEY=
GITHUB_USERNAME=
GITHUB_TOKEN=
