# Copy this to .env and fill in real values. Never commit .env.

# ── LLM ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL_MAIN=gpt-4o
OPENAI_MODEL_CHEAP=gpt-4o-mini

# ── App ───────────────────────────────────────────────────────────────
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO
ENVIRONMENT=development

# ── Auth (single-user app) ────────────────────────────────────────────
# A simple shared token between frontend and backend (running locally only).
APP_API_TOKEN=change-me-to-a-long-random-string

# ── Obsidian ──────────────────────────────────────────────────────────
OBSIDIAN_API_KEY=
OBSIDIAN_HOST=127.0.0.1
OBSIDIAN_PORT=27124
OBSIDIAN_VAULT_PATH=/Users/you/Documents/SecondBrain

# ── Storage ───────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/secondbrain.db
DATA_DIR=./data

# ── Knowledge agent ───────────────────────────────────────────────────
# Optional — for trend search. Tavily has a generous free tier.
TAVILY_API_KEY=
# Comma-separated list of RSS/Atom feed URLs
KNOWLEDGE_RSS_FEEDS=https://www.anthropic.com/news/rss.xml,https://openai.com/blog/rss.xml

# ── Finance — Plaid ───────────────────────────────────────────────────
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox   # sandbox | development | production
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US

# ── Calendar — Google ─────────────────────────────────────────────────
# Download from Google Cloud Console -> OAuth credentials
GOOGLE_OAUTH_CLIENT_SECRETS=./secrets/google_client_secret.json
GOOGLE_TOKEN_PATH=./secrets/google_token.json
GOOGLE_CALENDAR_ID=primary

# ── Health agent ──────────────────────────────────────────────────────
# Folder where 'Apple Health Auto Export' iOS app drops JSON files (via iCloud)
HEALTH_EXPORT_DIR=/Users/you/Library/Mobile Documents/com~apple~CloudDocs/HealthExports
# USDA FoodData Central — free, sign up at fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=
