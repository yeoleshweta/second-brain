# ── Render environment variables ─────────────────────────────────────────────
# Paste these into Render → your service → Environment tab.

# ── LLM ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL_MAIN=gpt-4o
OPENAI_MODEL_CHEAP=gpt-4o-mini

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=INFO
# Render injects PORT automatically — do not set APP_PORT here

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_API_TOKEN=generate-a-strong-random-token

# ── Database (Supabase PostgreSQL) ────────────────────────────────────────────
# From Supabase → Project Settings → Database → Connection string → URI
# Use the "connection pooling" string (port 6543) for serverless/free tier
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ── Obsidian ──────────────────────────────────────────────────────────────────
# Render free tier has ephemeral filesystem — notes survive restarts but not redeploys.
# For persistent notes, set up Obsidian Sync on your Mac + iPhone to pull from vault.
OBSIDIAN_API_KEY=          # leave empty → uses filesystem mode
OBSIDIAN_VAULT_PATH=/tmp/vault

# ── Storage ───────────────────────────────────────────────────────────────────
DATA_DIR=/tmp/data

# ── CORS — set after Vercel gives you your frontend URL ──────────────────────
# Example: FRONTEND_ORIGIN=https://second-brain-abc123.vercel.app
FRONTEND_ORIGIN=https://your-app.vercel.app

# ── Finance — Plaid ───────────────────────────────────────────────────────────
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US
# Generate: cd backend && uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PLAID_TOKEN_ENCRYPTION_KEY=

# ── Knowledge agent ───────────────────────────────────────────────────────────
TAVILY_API_KEY=
GITHUB_USERNAME=yeoleshweta
KNOWLEDGE_INTERESTS=AI,engineering,science,business,design,psychology
KNOWLEDGE_RSS_FEEDS=https://www.anthropic.com/news/rss.xml,https://openai.com/blog/rss.xml
