# Token must match backend's APP_API_TOKEN
VITE_API_TOKEN=change-me-to-a-long-random-string

# Hit the backend directly instead of going through Vite's dev proxy.
# Vite's proxy buffers SSE responses and can return 503; bypassing it with
# the backend URL (CORS is already allowed for localhost:5173) fixes this.
VITE_API_URL=http://localhost:8000
