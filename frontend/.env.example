# Token must match backend's APP_API_TOKEN
VITE_API_TOKEN=change-me-to-a-long-random-string

# Optional: override the API base URL. When unset (recommended), the frontend
# dynamically uses window.location.hostname:8000 — this works for both localhost
# and Tailscale access (phone → <mac-name>:5173 → <mac-name>:8000).
#
# Only set this if you need to override, e.g.:
# VITE_API_URL=http://localhost:8000
