# Frontend environment variables — copy to .env.local (never commit .env.local)

# ── For local development ─────────────────────────────────────────────────────
# Leave blank to use the Vite proxy (localhost:8000)
VITE_API_URL=

# Must match APP_API_TOKEN in backend/.env
VITE_API_TOKEN=change-me-to-a-long-random-string

# ── For Capacitor native app (iOS / Android) ──────────────────────────────────
# Point to your Railway URL so the native app talks to the cloud backend.
# Example:
# VITE_API_URL=https://second-brain-production.up.railway.app
# VITE_API_TOKEN=your-real-secret-token
#
# After changing these, rebuild: npm run mobile:ios
