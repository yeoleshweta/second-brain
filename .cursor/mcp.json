{
  "mcpServers": {
    "filesystem-vault": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${OBSIDIAN_VAULT_PATH}"
      ]
    },
    "fetch": {
      "command": "uvx",
      "args": ["mcp-server-fetch"]
    },
    "apple-books": {
      "command": "uvx",
      "args": ["apple-books-mcp@latest"]
    }
  }
}
